```{r Wrangle data for Word models}
biling_noun_frequency_long <-  biling_eng_noun_frequency %>% 
  # Keep only necessary columns
  select(study_id, item, age, english_item, eng_acquired, french_item, fr_acquired, cumulative_exp_Eng, cumulative_exp_Fre, exposure_balance, tok_per_mo, age_centered:fre_exposure_centered, exposure_balance_centered) %>% 
  rename(word_eng = english_item,
         word_fre = french_item,
         fre_acquired = fr_acquired) %>% 
  pivot_longer(
    cols = starts_with("word"),
    names_to = "language",
    names_prefix = "word_",
    values_to = "word",
    values_drop_na = TRUE # Removes french items that are not on the CDI
  ) %>% 
  # Create word_acquired and lang_exposure columns, set to English or French values, depending on the word's language
  mutate(word_acquired = case_when(language == "eng" ~ eng_acquired,
                                   language == "fre" ~ fre_acquired),
         lang_exposure = case_when(language == "eng" ~ cumulative_exp_Eng,
                                   language == "fre" ~ cumulative_exp_Fre),
         lang_exposure_centered = case_when(language == "eng" ~ eng_exposure_centered,
                                            language == "fre" ~ fre_exposure_centered),
         lang_exposure_round = case_when(lang_exposure >= 0 & lang_exposure <= .33 ~ "0-33% exposure",
                                         lang_exposure > .33 & lang_exposure <= .66 ~ "34-66% exposure",
                                         lang_exposure > .66 & lang_exposure <= 1 ~ "67-100% exposure")) %>% 
  # Estimate bilingual tokens per months
  mutate(biling_tok_per_month = tok_per_mo * lang_exposure,
         monoling_frequency_bins = case_when(tok_per_mo <= 100 ~ "0-100",
                                    tok_per_mo > 100 & tok_per_mo <= 200 ~ "101-200",
                                    tok_per_mo > 200 & tok_per_mo <= 300 ~ "201-300",
                                    tok_per_mo > 300 ~ "301+" # There is only one item (book) with frequency greater than 400, therefore it is grouped with the 401-500 bin
                                    )) %>% 
  # Remove "wide" columns 
  select(-c(eng_acquired:cumulative_exp_Fre, eng_exposure_centered, fre_exposure_centered)) 

save(biling_noun_frequency_long, file = "data/biling_noun_frequency_long.RDS")
```

