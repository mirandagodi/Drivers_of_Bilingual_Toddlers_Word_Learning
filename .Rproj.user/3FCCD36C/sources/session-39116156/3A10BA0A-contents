```{r Merge Eng and Fr dataframes}

EngFr_df <- full_join(Eng_df_itemID, Fr_df_itemID, by = c("study_id", "n_months", "te_id", "eng_item_num", "fr_item_num"), suffix = c("_eng", "_fr")) %>%
  # Replace with 0 the NAs in total produced in eng and fre because those children are in fact monolinguals.
  mutate(eng_est_total_produced = case_when(is.na(eng_est_total_produced) ~ 0,
                           TRUE ~ eng_est_total_produced),
         fr_est_total_produced = case_when(is.na(fr_est_total_produced) ~ 0,
                           TRUE ~ fr_est_total_produced)) %>%
  # Replace with NA the 0s in est_total_produced when a bilingual baby did not complete the CDI in one language, but did in the other
  mutate(eng_est_total_produced = case_when(eng_completed == FALSE ~ as.numeric(NA), 
                                            TRUE ~ eng_est_total_produced),
         fr_est_total_produced = case_when(fr_completed == FALSE ~ as.numeric(NA), 
                                            TRUE ~ fr_est_total_produced),
         age_eng = case_when(age_eng == 999 ~ as.numeric(NA),
                             TRUE ~ age_eng),
         age_fr = case_when(age_fr == 999 ~ as.numeric(NA),
                             TRUE ~ age_fr),
         num_datapts = case_when(is.na(TRUE_months_eng) ~ TRUE_months_fr,
                                 is.na(TRUE_months_fr) ~ TRUE_months_eng,
                                 TRUE_months_eng > TRUE_months_fr ~ TRUE_months_eng,
                                 TRUE_months_fr > TRUE_months_eng ~ TRUE_months_fr,
                                 TRUE ~ TRUE_months_eng)) %>% 
  # Flag any cases where sex does not match across languages
  mutate(sex_match = case_when(sex_eng == sex_fr ~ "yes",
                               is.na(sex_fr) ~ "yes",
                               is.na(sex_eng) ~"yes",
                               TRUE ~ "no"))

# Determine sex of children with mismatch across languages
mismatch_sex_df <- EngFr_df %>% 
  group_by(study_id, n_months) %>% 
  filter(row_number() == 1,
    sex_match == "no") %>% 


# Fix age (Due to the nature of the administration process where the questionnaires are sent on the 1st of each month, there would be overlaps in the age when the questionnaires are filled. So when generating the report, we rely on the n_month variable to generate an estimate age to avoid overlaps.)
EngFr_df_agefixed <- EngFr_df %>% 
  # Sometimes parents may have missed a language (i.e., no data), so replace NA in a missing language with the age in the other language
     mutate(age_fixed = case_when(is.na(age_eng) ~ age_fr, 
                           is.na(age_fr) ~ age_eng,
                            # When both languages are available, compare the age across two languages and keep the smaller number (i.e., the age they first joined the project)
                           age_eng < age_fr ~ age_eng,
                           age_eng > age_fr ~ age_fr,
                           # Otherwise, return the age in the English form (since this should be the same as the age in the French form)
                           TRUE ~ age_eng)) %>% 
  # There was one child with mismatched sex in English and French; the right information was manually checked. Create a single column for sex
  mutate(sex = case_when(is.na(sex_eng) ~ sex_fr, 
                         is.na(sex_fr) ~ sex_eng,
                         sex_eng == sex_fr ~ sex_eng, 
                         study_id == "S0037" ~ sex_fr,
                         TRUE ~ sex_eng)) %>% 
  group_by(study_id) %>%
  mutate(starting_age = min(age_fixed, na.rm = TRUE)) %>% # Extract the minimum age as the starting age of the project
  ungroup() %>%
  mutate(age = age_fixed) 

```

```{r Estimate word and concept vocabulary scores}

# Word vocabulary score
word_concept_scores <- EngFr_df_agefixed %>%
  mutate(words_produced = rowSums(across(c(eng_est_total_produced, fr_est_total_produced)), na.rm = FALSE),
         concept_acquired = case_when(eng_acquired == 1 | fr_acquired == 1 ~ 1, TRUE ~ 0), # Determine if a concept was acquired
         te_acquired = case_when(eng_acquired == 1 & fr_acquired == 1 ~ 1, TRUE ~ 0)) %>% # Determine if a TE was acquired
  # Estimate number of TEs produced
  group_by(study_id, n_months) %>%
  mutate(te_produced = sum(te_acquired)) %>%
  # Concept vocabulary score
  mutate(concepts_produced = words_produced - te_produced) %>%
  # Reorder columns
  relocate(words_produced, .after = n_months) %>%
  relocate(concepts_produced, .after = words_produced) %>%
  relocate(te_produced, .after = concepts_produced) %>% 
  relocate(eng_est_total_produced, .after = concepts_produced) %>%
  relocate(fr_est_total_produced, .after = eng_est_total_produced) %>%
  relocate(concept_acquired, .after = fr_est_total_produced) %>% 
  relocate(fr_completed, .after = eng_completed) %>%
  relocate(sex, .after = n_months) %>% 
  # Remove unnecessary columns
  select(study_id, n_months:fr_completed, english_item:te_id, french_item:num_datapts, age, starting_age) %>% 
  ungroup()

```

```{r Merge CDI and LEQ data}
CDI_LEQ_df <- word_concept_scores %>% 
  # Round age to match with LEQ data
  mutate(age_round = round(age, digits = 0)) %>% 
  left_join(LEQ_01_all_phases_df, by = c("study_id", "age_round"="end_age")) %>% 
  # Identify and remove rows of CDI data without corresponding cumulative exposure
  mutate(missing_exposure = case_when(eng_completed = TRUE & is.na(cumulative_exp_Eng) ~ "missing_Eng_exposure",
                                      fr_completed = TRUE & is.na(cumulative_exp_Fre) ~ "missing_Fre_exposure")) %>% 
  filter(is.na(missing_exposure)) %>% 
  # Create column that groups language exposure 
  mutate(Eng_exposure_round = case_when(cumulative_exp_Eng >= 0 & cumulative_exp_Eng <= .33 ~ "0-33% exposure",
                                        cumulative_exp_Eng > .33 & cumulative_exp_Eng <= .66 ~ "34-66% exposure",
                                        cumulative_exp_Eng > .66 & cumulative_exp_Eng <= 1 ~ "67-100% exposure"),
         Fre_exposure_round = case_when(cumulative_exp_Fre >= 0 & cumulative_exp_Fre <= .33 ~ "0-33% exposure",
                                        cumulative_exp_Fre > .33 & cumulative_exp_Fre <= .66 ~ "34-66% exposure",
                                        cumulative_exp_Fre > .66 & cumulative_exp_Fre <= 1 ~ "67-100% exposure")
         ) %>% 
  # Remove rows where neither English nor French CDI were completed
  mutate(both_not_completed = case_when(eng_completed == FALSE & fr_completed == FALSE ~ "both_missing",
                                        is.na(eng_completed) & fr_completed == FALSE ~ "both_missing",
                                        is.na(fr_completed) & eng_completed == FALSE ~ "both_missing"
                                        )) %>% 
  filter(is.na(both_not_completed))

```

```{r Prep data}
# Merge CDI+LEQ and Eng word frequency data
biling_eng_word_frequency <- CDI_LEQ_df %>% 
  # # Remove rows where English CDI was not completed
  # filter(eng_completed == TRUE) %>% 
  full_join(eng_tokens_per_month, by = "eng_item_num") %>% 
  relocate(item, .after = english_item) %>% 
  # Estimate tokens per month based on each child language exposure
  mutate(eng_biling_tok_per_month = cumulative_exp_Eng * tok_per_mo,
         fre_biling_tok_per_month = cumulative_exp_Fre * tok_per_mo) %>% 
  # Remove English homophones
  filter(! item %in% eng_cdi_homophones_df$item) %>% 
  # Set non-dominant exposure for exposure balance
  mutate(exposure_balance = case_when(cumulative_exp_Eng < cumulative_exp_Fre ~ cumulative_exp_Eng,
                                      cumulative_exp_Fre < cumulative_exp_Eng ~ cumulative_exp_Fre,
                                      TRUE ~ 0.5
                                        ),
         # Create column that groups exposure balance
         exposure_balance_round = case_when(exposure_balance >= 0 & exposure_balance <= .17 ~ "0-17% balance",
                                        exposure_balance > .17 & exposure_balance <= .33 ~ "17-33% balance",
                                        exposure_balance > .33 & exposure_balance <= .5 ~ "33-50% balance")
         ) %>%  
  # Assign to bins of 100 tokens
  mutate(monoling_frequency_bins = case_when(tok_per_mo <= 100 ~ "0-100",
                                    tok_per_mo > 100 & tok_per_mo <= 200 ~ "101-200",
                                    tok_per_mo > 200 & tok_per_mo <= 300 ~ "201-300",
                                    # tok_per_mo > 300 & tok_per_mo <= 400 ~ "301-400",
                                    # tok_per_mo > 400 & tok_per_mo <= 500 ~ "401-500",
                                    # tok_per_mo > 500 ~ "501-600"
                                    tok_per_mo > 300 ~ "301+" # There is only one item (book) with frequency greater than 400, therefore it is grouped with the 401-500 bin
                                    ),
         eng_biling_frequency_bins= case_when(eng_biling_tok_per_month <= 100 ~ "0-100",
                                    eng_biling_tok_per_month > 100 & eng_biling_tok_per_month <= 200 ~ "101-200",
                                    eng_biling_tok_per_month > 200 & eng_biling_tok_per_month <= 300 ~ "201-300",
                                    eng_biling_tok_per_month > 300 & eng_biling_tok_per_month <= 400 ~ "301-400",
                                    eng_biling_tok_per_month > 400 & eng_biling_tok_per_month <= 500 ~ "401-500",
                                    eng_biling_tok_per_month > 500 ~ "501-600"),
         fre_biling_frequency_bins= case_when(fre_biling_tok_per_month <= 100 ~ "0-100",
                                    fre_biling_tok_per_month > 100 & fre_biling_tok_per_month <= 200 ~ "101-200",
                                    fre_biling_tok_per_month > 200 & fre_biling_tok_per_month <= 300 ~ "201-300",
                                    fre_biling_tok_per_month > 300 & fre_biling_tok_per_month <= 400 ~ "301-400",
                                    fre_biling_tok_per_month > 400 & fre_biling_tok_per_month <= 500 ~ "401-500",
                                    fre_biling_tok_per_month > 500 ~ "501-600")) %>% 
  # Remove unnecessary columns
  select(-c(eng_completed, fr_completed, eng_item_num, fr_item_num, cumulative_exp_L3:missing_exposure, both_not_completed))


# Keep only nouns
biling_eng_noun_frequency <- biling_eng_word_frequency %>% 
  filter(lexical_class == "nouns") 

# Keep only word frequency for each item, not each child
unique_nouns_only_word_frequency <- biling_eng_noun_frequency %>% 
  group_by(item) %>% 
  filter(row_number() == 1) %>% # Keep one row per item
  ungroup() %>% 
  select(item, lexical_class, tok_per_mo)

hist(unique_nouns_only_word_frequency$tok_per_mo)
# Estimate mean and median noun frequency to center tokens per month
mean_noun_frequency <- round(mean(unique_nouns_only_word_frequency$tok_per_mo), digits = 3) #53.668
median_noun_frequency <- round(median(unique_nouns_only_word_frequency$tok_per_mo), digits = 2)


# Keep only language exposure for each child at each month, not each item
unique_child_exposure <- biling_eng_noun_frequency %>% 
  group_by(study_id, n_months) %>% 
  filter(row_number() == 1) %>% # Keep one row per child per month
  ungroup() %>% 
  select(study_id, n_months, age, cumulative_exp_Eng, cumulative_exp_Fre, Eng_exposure_round)
# Estimate median age, English and French exposure
median_age <- round(median(unique_child_exposure$age), digits = 2)
median_eng_exposure <- round(median(unique_child_exposure$cumulative_exp_Eng), digits = 2)
median_fre_exposure <- round(median(unique_child_exposure$cumulative_exp_Fre), digits = 2)


# Center age, tokens per month, and English exposure
biling_eng_noun_frequency <- biling_eng_noun_frequency %>% 
  # Center variables
  mutate(age_centered = age - 24, # Age centered at 2 years, approximately the middle of the age range
         tok_per_mo_centered = tok_per_mo - mean_noun_frequency, # Frequency centered at the average noun frequency (53.668)
         eng_exposure_centered = cumulative_exp_Eng - 0.5, # English exposure centered to completely balanced exposure
         fre_exposure_centered = cumulative_exp_Fre - 0.5, # French exposure centered to completely balanced exposure
         exposure_balance_centered = exposure_balance - 0.5 # Exposure balance centered to completely balanced exposure
         ) %>% 
  # Median split
  mutate(age_median_split = as.factor(case_when(age <= median_age ~ "below median age",
                                      age > median_age ~ "above median age")),
         age_median_split = factor(age_median_split, levels = c("below median age", "above median age")),
         noun_frequency_median_split = case_when(tok_per_mo < median_noun_frequency ~ "below median frequency",
                                                 tok_per_mo > median_noun_frequency ~ "above median frequency"),
         noun_frequency_median_split = factor(noun_frequency_median_split, levels = c("below median frequency", "above median frequency")),
         eng_exposure_median_split = case_when(cumulative_exp_Eng < median_eng_exposure ~ "below median English exposure",
                                               cumulative_exp_Eng > median_eng_exposure ~ "above median English exposure"),
         eng_exposure_median_split = factor(eng_exposure_median_split, levels = c("below median English exposure", "above median English exposure")),
         )

save(biling_eng_noun_frequency, file = "data/biling_eng_noun_frequency.RDS")
