  mutate(scaled_age_centered = scale(age_centered),
         scaled_tok_per_mo_centered = scale(tok_per_mo_centered))

# Run model with scaled predictors
scaled_m_eng_interactive_age_tokmo_nouns_only <- 
  glmer(produces ~ -1 + scaled_age_centered * scaled_tok_per_mo_centered + (1 | eng_item) + (1 | person), 
