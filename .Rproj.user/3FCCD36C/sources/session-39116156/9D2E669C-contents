# Models using Kachergis et al. monolingual data of nouns only. Files were downloaded from their [OSF repository](https://osf.io/c5u49/).
```{r Read CHILDES data}
# Read Rdata file containing CHILDES data processed by Kachergis et al.
load("data/engWS_preprocessed.Rdata")


# Estimate monthly and lifetime tokens for each child following description on supplemental materials
eng_word_frequency <- d_wf %>% 
  mutate(tok_per_mo = prob * 438336, # The average child hears a total of 438,336 child-directed tokens per month
         # Assign to bins of 100 tokens
         frequency_bins = case_when(tok_per_mo <= 100 ~ "0-100",
                                    tok_per_mo > 100 & tok_per_mo <= 200 ~ "101-200",
                                    tok_per_mo > 200 & tok_per_mo <= 300 ~ "201-300",
                                    tok_per_mo > 300 ~ "301+"), # There is only one item (book) with frequency greater than 400, therefore it is grouped with the 300+ bin
         
         
         # # Assign to bins of 50 tokens
         # frequency_bins = as.factor(case_when(tok_per_mo <= 50 ~ "1-50",
         #                            tok_per_mo > 50 & tok_per_mo <= 100 ~ "51-100",
         #                            tok_per_mo > 100 & tok_per_mo <= 150 ~ "101-150",
         #                            tok_per_mo > 150 & tok_per_mo <= 200 ~ "151-200",
         #                            tok_per_mo > 200 & tok_per_mo <= 250 ~ "201-250",
         #                            tok_per_mo > 250 ~ "251 or more")),
         lifetime_tokens = tok_per_mo * age) # Lifetime tokens are the total tokens of a word a child has heard at a given age

# Keep only word frequency for each item, not each child
eng_tokens_per_month <- eng_word_frequency %>% 
  group_by(item) %>% 
  filter(row_number() == 1) %>% # Keep one row per item
  ungroup() %>% 
  select(item, lexical_class, word_count, tok_per_mo) %>% 
  mutate(eng_item_num = row_number()) # This will be needed to merge with bilingual data
save(eng_tokens_per_month , file = "data/eng_tokens_per_month.RDS")
```

```{r English Wordbank data}
# Get item info
eng_ws_items <- get_item_data("English (American)", "WS") %>%
  select(item_id, item_definition, uni_lemma, lexical_category) %>% 
  rename(eng_item = item_definition
         ) %>% 
  filter(!is.na(lexical_category)) # Keep only rows for single items, not questions about past tense, plurals, etc.

# Get administration data
eng_ws_data <- get_instrument_data(language = "English (American)",
                                   form = "WS",
                                   administration_info = TRUE)
```

```{r Merge Wordbank datasets}
# Merge item and administration data, and word frequency data
eng_cdi_data <- left_join(eng_ws_items, eng_ws_data, by = "item_id") %>% 
  mutate(produces = case_when(produces == TRUE ~ 1,
                              produces == FALSE ~ 0),
         person = as.factor(child_id)) %>% 
  right_join(eng_tokens_per_month, by = c("eng_item" = "item")) %>% # Merge with English word frequency data. Right join so only items with word frequency data are kept
  
  # rename(lexical_class = lexical_category) %>% 
  select(person, produces, age, production, eng_item, uni_lemma:tok_per_mo)

# 312 nouns
summary_eng_lexical_class <- eng_cdi_data %>% 
  group_by(eng_item) %>% 
  filter(row_number() == 1) %>% 
  ungroup() %>% 
  group_by(lexical_class) %>% 
  summarise(N_items = n())
```

## Models without homophones
There are some homophones in the CDI (e.g., drink as a noun and as a verb); they were assigned the same frequency (tokens per month) in CHILDES. The following models are run without these words, as we don't know these words true frequency.
```{r Identify homophones}
# Identify homophones
eng_cdi_homophones_df <- eng_tokens_per_month %>% 
  filter(str_detect(item, "[(]")) %>% # Keep rows where the item has parentheses, which specify the meaning of the word
  arrange(item) %>%
  group_by(tok_per_mo) %>%
  mutate(tok_per_mo = as.character(round(tok_per_mo, digits = 5))) %>% 
  mutate(is_homophone = case_when(row_number() > 1 ~ "yes",
                                  lead(row_number()) > 1 ~ "yes",
         TRUE ~ "no")) %>% 
  filter(is_homophone == "yes")
  # mutate(tok_per_mo = as.character(round(tok_per_mo, digits = 5)),
  #        is_homophone = case_when(tok_per_mo == lag(tok_per_mo) ~ "yes",
  #                                 lead(tok_per_mo) == tok_per_mo ~ "yes",
  #        TRUE ~ "no"))
save(eng_cdi_homophones_df, file = "data/eng_cdi_homophones_df.RDS")

# Remove homophones
without_homophones_word_frequency <- eng_cdi_data %>% 
  filter(! (eng_item %in% eng_cdi_homophones_df$item)) 
```

## Models with nouns only
Run the models only with nouns. NOTE: homophones were already removed from this dataset.
```{r Nouns only data}
# Remove non-nouns (271 nouns)
mono_eng_nouns_only_word_frequency <- without_homophones_word_frequency %>% 
  filter(lexical_class == "nouns")

# Keep only word frequency for each item, not each child. 300 nouns
unique_nouns_only_word_frequency <- mono_eng_nouns_only_word_frequency %>% 
  group_by(eng_item) %>% 
  filter(row_number() == 1) %>% # Keep one row per item
  select(eng_item, lexical_class, tok_per_mo)

hist(unique_nouns_only_word_frequency$tok_per_mo)

# Estimate average noun frequency to center tokens per month
mean_eng_noun_frequency <- mean(unique_nouns_only_word_frequency$tok_per_mo) # 53.668

# Center age and tokens per month
mono_eng_nouns_only_word_frequency <- mono_eng_nouns_only_word_frequency %>% 
  # Center variables
  mutate(age_centered = age - 24,
         tok_per_mo_centered = tok_per_mo - mean_eng_noun_frequency) %>% 
  filter(!is.na(child_id)) %>% 
  # Estimate lifetime tokens
  mutate(lifetime_tokens = tok_per_mo * age)

save(mono_eng_nouns_only_word_frequency, file = "data/mono_eng_nouns_only_word_frequency.RDS")

# Sample descriptives
mono_eng_sample_summ <- mono_eng_nouns_only_word_frequency %>% 
  group_by(child_id) %>%
  filter(row_number() == 1) %>% 
  ungroup() %>% 
  summarise(N_child = n(),
            mean_age = round(mean(age), digits = 2),
            sd_age = round(sd(age), digits = 2))

```

```{r Nouns only models}
# Run models
load("data/mono_eng_nouns_only_word_frequency.RDS")

# Lifetime tokens
m_eng_lifetime_tokens_nouns_only <- 
  glmer(produces ~ -1 + lifetime_tokens + (1 | eng_item) + (1 | person), 
                           data = mono_eng_nouns_only_word_frequency,
                           family = binomial,
                           nAGQ = 0) # This was done by Kachergis et al.
beep()
# Save files, so we don't need to run the models every time
save(m_eng_lifetime_tokens_nouns_only, file = "models/mono_eng_lifetime_tokens_nouns_only.RDS")

# Additive: age + tokens per month
m_eng_additive_age_tokmo_nouns_only <- 
  glmer(produces ~ -1 + age_centered + tok_per_mo_centered + (1 | eng_item) + (1 | person), 
                           data = mono_eng_nouns_only_word_frequency,
                           family = binomial,
                           nAGQ = 0) # This was done by Kachergis et al.
beep()
# Save files, so we don't need to run the models every time
save(m_eng_additive_age_tokmo_nouns_only, file = "models/mono_eng_additive_age_tokmo_nouns_only.RDS")

# Interactive: age * tokens per month
m_eng_interactive_age_tokmo_nouns_only <- 
  glmer(produces ~ -1 + age_centered * tok_per_mo_centered + (1 | eng_item) + (1 | person), 
                           data = mono_eng_nouns_only_word_frequency,
                           family = binomial,
                           nAGQ = 0) # This was done by Kachergis et al.
beep()
# Save files, so we don't need to run the models every time
save(m_eng_interactive_age_tokmo_nouns_only, file = "models/mono_eng_interactive_age_tokmo_nouns_only.RDS")
```

