load("models/mono_eng_interactive_age_tokmo_nouns_only.RDS")

# Compare lifetime tokens vs additive age+tokens per months models
eng_lifetok_additive_comparison <-  anova(m_eng_lifetime_tokens_nouns_only, m_eng_additive_age_tokmo_nouns_only)
eng_lifetok_additive_comparison

# Compare lifetime tokens vs interactive age*token per month models
eng_lifetok_interactive_comparison <- anova(m_eng_lifetime_tokens_nouns_only, m_eng_interactive_age_tokmo_nouns_only)
eng_lifetok_interactive_comparison

# Compare additive age+tokens per months vs interactive age*token per month models
eng_additive_interactive_comparison <- anova(m_eng_additive_age_tokmo_nouns_only, m_eng_interactive_age_tokmo_nouns_only)
eng_additive_interactive_comparison

beep()

# Save model comparisons
save(eng_lifetok_additive_comparison, eng_lifetok_interactive_comparison, eng_additive_interactive_comparison, file = "models/mono_eng_lifetok_additive_interactive_models_comparison")

```

```{r Standardized model}
load("data/mono_eng_nouns_only_word_frequency.RDS")

