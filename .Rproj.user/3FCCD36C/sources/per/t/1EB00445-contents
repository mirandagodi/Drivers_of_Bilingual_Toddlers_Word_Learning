```{r Keep nouns only}
# Remove non-nouns
# 287 nouns
nouns_only_fre_cdi_data <- without_homophones_fre_cdi_data %>% 
  filter(lexical_class == "nouns")

# Keep only word frequency for each item, not each child
unique_nouns_only_fre_cdi_data <- nouns_only_fre_cdi_data %>% 
  group_by(fre_item) %>% 
  filter(row_number() == 1) %>% # Keep one row per item
  select(fre_item, lexical_class, tok_per_mo)

hist(unique_nouns_only_fre_cdi_data$tok_per_mo)

# Estimate average noun frequency to center tokens per month
mean_fre_noun_frequency <- mean(unique_nouns_only_fre_cdi_data$tok_per_mo) # 57.392

# Center age and tokens per month
mono_fre_nouns_only_cdi_data <- nouns_only_fre_cdi_data %>% 
  # Center variables
  mutate(age_centered = age - 24,
         tok_per_mo_centered = tok_per_mo - mean_fre_noun_frequency,
         frequency_bins = case_when(tok_per_mo <= 100 ~ "0-100",
                                    tok_per_mo > 100 & tok_per_mo <= 200 ~ "101-200",
                                    tok_per_mo > 200 & tok_per_mo <= 300 ~ "201-300",
                                    # tok_per_mo > 300 & tok_per_mo <= 400 ~ "301-400",
                                    # tok_per_mo > 400 & tok_per_mo <= 500 ~ "401-500",
                                    # tok_per_mo > 500 ~ "501-600"
                                    tok_per_mo > 300 ~ "301+"), # There is only one item (book) with frequency greater than 400, therefore it is grouped with the 401-500 bin
         lifetime_tokens = tok_per_mo * age
         ) %>% 
  filter(!is.na(child_id))

save(mono_fre_nouns_only_cdi_data, file = "data/mono_fre_nouns_only_cdi_data.RDS")

# Sample descriptives
mono_fre_sample_summ <- mono_fre_nouns_only_cdi_data %>% 
  group_by(child_id) %>%
  filter(row_number() == 1) %>% 
  ungroup() %>% 
  summarise(N_child = n(),
            mean_age = round(mean(age), digits = 2),
            sd_age = round(sd(age), digits = 2))

mono_fre_item_summ <- mono_fre_nouns_only_cdi_data %>% 
  group_by(fre_item) %>%
  filter(row_number() == 1) 
```

```{r Nouns only models}
load("data/mono_fre_nouns_only_cdi_data.RDS")

# Run models
# Lifetime tokens
m_fre_lifetime_tokens_nouns_only <- 
  glmer(produces ~ -1 + lifetime_tokens + (1 | fre_item) + (1 | person), 
                           data = mono_fre_nouns_only_cdi_data,
                           family = binomial,
                           nAGQ = 0) # This was done by Kachergis et al.
beep()
# Save files, so we don't need to run the models every time
save(m_fre_lifetime_tokens_nouns_only, file = "models/mono_fre_lifetime_tokens_nouns_only.RDS")

# Additive: age + tokens per month
m_fre_additive_age_tokmo_nouns_only <- 
  glmer(produces ~ -1 + age_centered + tok_per_mo_centered + (1 | fre_item) + (1 | person), 
                           data = mono_fre_nouns_only_cdi_data,
                           family = binomial,
                           nAGQ = 0) # This was done by Kachergis et al.
beep()
# Save files, so we don't need to run the models every time
save(m_fre_additive_age_tokmo_nouns_only, file = "models/mono_fre_additive_age_tokmo_nouns_only.RDS")

# Interactive: age * tokens per month
m_fre_interactive_age_tokmo_nouns_only <- 
  glmer(produces ~ -1 + age_centered * tok_per_mo_centered + (1 | fre_item) + (1 | person), 
                           data = mono_fre_nouns_only_cdi_data,
                           family = binomial,
                           nAGQ = 0) # This was done by Kachergis et al.
beep()
# Save files, so we don't need to run the models every time
save(m_fre_interactive_age_tokmo_nouns_only, file = "models/mono_fre_interactive_age_tokmo_nouns_only.RDS")
```

