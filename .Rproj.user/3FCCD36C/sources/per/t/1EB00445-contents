```{r Merge Wordbank datasets}
load("data/eng_tokens_per_month.RDS")
# Merge item and administration data, and word frequency data
fre_cdi_data <- left_join(fre_ws_items, fre_ws_data, by = "item_id") %>% 
  mutate(produces = case_when(produces == TRUE ~ 1,
                              produces == FALSE ~ 0),
         person = as.factor(child_id)) %>% 
  # MERGE WITH WORD FREQUENCY DATA. CHOOSE FRENCH OR ENGLISH
  # right_join(fre_tokens_per_month, by = "fre_item") %>%  # Merge with French word frequency data. Right join so only items with word frequency data are kept
  right_join(eng_tokens_per_month, by = c("eng_item" = "item")) %>% # Merge with English word frequency data. Right join so only items with word frequency data are kept
  
  # rename(lexical_class = lexical_category) %>% 
  select(person, produces, age, production, fre_item, uni_lemma:tok_per_mo)

# 296 nouns when merged with English word frequency. 183 nouns when merged with French word frequency.
summary_fre_lexical_class <- fre_cdi_data %>% 
  group_by(fre_item) %>% 
  filter(row_number() == 1) %>% 
  ungroup() %>% 
  group_by(lexical_class) %>% 
  summarise(N_items = n())
```

```{r Identify homophones}
# Identify homophones
# 9 nouns that are homophones
fre_cdi_homophones_df <- fre_tokens_per_month %>% 
  mutate(possible_homophone = case_when(str_detect(uni_lemma, "[(]") ~ "yes", # Identify items that may be homophones if they have parentheses either in English or French.
                                        str_detect(fre_item, "[(]") ~ "yes",
                                        str_detect(fre_item, "parc") ~ "yes")) %>% 
  # Keep rows where the item (in English) has parentheses, which specify the meaning of the word. Some words are the same in English (e.g., brush) but slightly different in French (e.g., brosse and brosser), therefore they don't have parentheses in French, but still have the same word frequency. These words will be considered homophones.
  filter(possible_homophone == "yes") %>% # Keep only potential homophones
  arrange(uni_lemma) %>%
  group_by(tok_per_mo) %>% # Group word pairs with the same frequency
  mutate(is_homophone = case_when(row_number() > 1 ~ "yes",
                                  lead(row_number()) > 1 ~ "yes",
         TRUE ~ "no")) %>% 
  filter(is_homophone == "yes")

save(fre_cdi_homophones_df, file = "data/fre_cdi_homophones_df.RDS")

# Remove homophones
without_homophones_fre_cdi_data <- fre_cdi_data %>%
  filter(! (fre_item %in% fre_cdi_homophones_df$fre_item))
```

