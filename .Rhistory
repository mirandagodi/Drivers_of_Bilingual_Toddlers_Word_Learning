# Estimate the weighted mean of tokens per session
group_means <- c(127, 199, 256, 392, 414, 486, 494, 491, 475)
group_sizes <- c(39, 32, 38, 36, 37, 34, 33, 35, 31)
mean_tokens_per_session <-  weighted.mean(group_means, group_sizes)
# Estimate tokens per month
mean_tokens_per_month <- round(mean_tokens_per_session * 3 * # Tokens per hour, given that sessions were ~20 minutes long
12 * # Tokens per day, assuming each child hears 12 hrs of child-directed speech per day
30.44, # Token per month, with 30.44 days in an average month
digits = 0)
mean_tok_per_mo_eng <- mean(eng_fre_tokens_per_month_nonhomophones$tok_per_mo_eng)
mean_tok_per_mo_fre <- mean(eng_fre_tokens_per_month_nonhomophones$tok_per_mo_fre)
hist(eng_fre_tokens_per_month_nonhomophones$tok_per_mo_eng)
hist(eng_fre_tokens_per_month_nonhomophones$tok_per_mo_fre)
sd_tok_per_mo_eng <- sd(eng_fre_tokens_per_month_nonhomophones$tok_per_mo_eng)
sd_tok_per_mo_fre <- sd(eng_fre_tokens_per_month_nonhomophones$tok_per_mo_eng)
mean_tok_per_mo_eng <- mean(eng_fre_tokens_per_month_nonhomophones$tok_per_mo_eng)
mean_tok_per_mo_fre <- mean(eng_fre_tokens_per_month_nonhomophones$tok_per_mo_fre)
sd_tok_per_mo_eng <- sd(eng_fre_tokens_per_month_nonhomophones$tok_per_mo_eng)
sd_tok_per_mo_fre <- sd(eng_fre_tokens_per_month_nonhomophones$tok_per_mo_fre)
?geom_hline
