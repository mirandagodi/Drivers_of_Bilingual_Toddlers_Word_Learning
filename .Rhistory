library(lme4)
library(performance)
library(report)
library(jtools)
library(sjPlot)
library(effects)
library(ggeffects)
library(ggh4x)
library(gtsummary)
library(ggpubr)
library(ggsci)
LEQ_01_all_phases_df <- read_csv("data/01_LEQ_columns_all_phases.csv")
Eng_01_df <- read_csv("data/01_Eng_columns.csv")
Fr_01_df <- read_csv("data/01_Fr_columns.csv")
# Read translation equivalents data
TE_list <- read_csv("data/ws_te_list_full.csv") %>%
# remove unnecessary columns
select(-c(word_en, word_fr, one_to_many)) %>%
rename(eng_item_num = en_item_num)
# English word frequency
load("data/eng_tokens_per_month.RDS")
# English CDI homophones
load("data/eng_cdi_homophones_df.RDS")
# English CDI homophones
load("data/fre_cdi_homophones_df.RDS")
frequency_colors <- c("#1A8AD9", "#199DAF", "#19B084", "#18C35A")
exposure_colors <- c("#EDD93D", "#D8872A", "#C23417")
# Identify participants with health or developmental issues
# Low weight at birth, not full-term, hearing loss, major illness, speech/language/developmental issues
# Has your child experienced chronic ear infections (5 or more)?: ear_infections_boolean: 0=no, 1=yes. Some parents answered "yes" but said that it did not affect their child's hearing. We excluded babies whose parents reported hearing issues due to ear infection.
# Do you suspect that your child may have hearing loss?: hearing_loss_boolean: 0=no, 1=yes
# Has your child had any major illnesses, hospitalizations, or diagnosed disabilities?: illnesses_boolean: 0=no, 1=yes
# Has your child ever received any services for speech, language, or development issues?: services_boolean: 0=no, 1=yes
# Are you worried about your child's progress in language or communication?: worried_boolean: 0=no, 1=yes
# English
# Identify participants with one or more health exclusion criteria, label them as 'exclude'
Eng_df_health <- Eng_01_df %>%
group_by(study_id) %>%
mutate(exclude_health = case_when((birth_weight_lb > 0 & birth_weight_lb < 5.5)
| (early_or_late == 'Early' & due_date_diff >= 4)
#| ear_infections_boolean == 1
| hearing_loss_boolean == 1
# | illnesses_boolean == 1
# | services_boolean == 1
# | worried_boolean == 1
# Babies with health issues specified in conversation with parents
| study_id == 'S043' | study_id == 'S048' | study_id == 'S060' | study_id == 'S068' | study_id == 'S127'
# Check S101, S132
~ 'exclude',
TRUE ~ 'keep')) %>%
relocate(exclude_health, .after = age) %>%
ungroup()
# Create df with the study_id of participants that will be excluded based on health criteria
Eng_df_exclude_health <- Eng_df_health %>%
filter(exclude_health == 'exclude') %>%
distinct(study_id)
# French
# Identify participants with one or more health exclusion criteria, label them as 'exclude'
Fr_df_health <- Fr_01_df %>%
mutate(exclude_health = case_when((birth_weight_lb > 0 & birth_weight_lb < 5.5)
| (early_or_late == 'Early' & due_date_diff >= 4)
#| ear_infections_boolean == 1
| hearing_loss_boolean == 1
# | illnesses_boolean == 1
# | services_boolean == 1
# | worried_boolean == 1
# Babies with health issues specified in conversation with parents
| study_id == 'S043' | study_id == 'S048' | study_id == 'S060' | study_id == 'S068' | study_id == 'S127'
# Check S101, S132
~ 'exclude',
TRUE ~ 'keep')) %>%
relocate(exclude_health, .after = age)
# Create df with the study_id of participants that will be excluded based on health criteria
Fr_df_exclude_health <- Fr_df_health %>%
filter(exclude_health == 'exclude') %>%
distinct(study_id)
# Identify participants based on language exposure criteria: Exposure change greater than 25% at any two points, multilingual participants (10% or more exposure to a third or fourth language)
LEQ_df_exposure_change <- LEQ_01_all_phases_df %>%
group_by(study_id) %>%
mutate(Eng_exclude_exposure_change = case_when((max(cumulative_exp_Eng)-min(cumulative_exp_Eng))>.2 ~ 'exclude'
, TRUE ~ 'keep'),
Fr_exclude_exposure_change = case_when((max(cumulative_exp_Fre)-min(cumulative_exp_Fre))>.2 ~ 'exclude'
, TRUE ~ 'keep'),
L3_exclude_exposure = case_when(max(cumulative_exp_L3)>=.1 ~ 'exclude'
, TRUE ~ 'keep'),
L4_exclude_exposure = case_when(max(cumulative_exp_L4)>=.1 ~ 'exclude'
, TRUE ~ 'keep')) %>%
ungroup()
# Create df with the study_id of participants that will be excluded based on exposure change and L3 and L4 exposure
# English
Eng_df_exclude_exposure_change <- LEQ_df_exposure_change %>% filter(Eng_exclude_exposure_change == 'exclude') %>% distinct(study_id)
# French
Fr_df_exclude_exposure_change <- LEQ_df_exposure_change %>% filter(Fr_exclude_exposure_change == 'exclude') %>% distinct(study_id)
# L3
L3_df_exclude_exposure <- LEQ_df_exposure_change %>% filter(L3_exclude_exposure == 'exclude') %>% distinct(study_id)
# L4
L4_df_exclude_exposure <- LEQ_df_exposure_change %>% filter(L4_exclude_exposure == 'exclude') %>% distinct(study_id)
# Create new df without the rows of the excluded participants
# English
Eng_df_keepers <- Eng_01_df %>%
filter(!(study_id %in% Eng_df_exclude_health$study_id |
study_id %in% Fr_df_exclude_health$study_id |
study_id %in% Eng_df_exclude_exposure_change$study_id |
# study_id %in% Fr_df_exclude_exposure_change$study_id | # Exclude participants listwise
study_id %in% L3_df_exclude_exposure$study_id |
study_id %in% L4_df_exclude_exposure$study_id)) %>%
# Create column for the sum the produced words
mutate(eng_est_total_produced = rowSums(across(baa_baa:then), na.rm = TRUE)) %>%
# Rearrange column orders
relocate(eng_est_total_produced, .after = age)
Fr_df_keepers <- Fr_01_df %>%
filter(!(study_id %in% Fr_df_exclude_health$study_id |
study_id %in% Eng_df_exclude_health$study_id |
study_id %in% Fr_df_exclude_exposure_change$study_id |
# study_id %in% Eng_df_exclude_exposure_change$study_id | # Exclude participants listwise
study_id %in% L3_df_exclude_exposure$study_id |
study_id %in% L4_df_exclude_exposure$study_id)) %>%
# Create column for the sum the produced words
mutate(fr_est_total_produced = rowSums(across(aie:si), na.rm = TRUE)) %>%
# Rearrange column orders
relocate(fr_est_total_produced, .after = age)
# S01, S06, and S81 have 0 in the first months because they did not know any words in French
# Append item_id info to CDI data
# English
Eng_df_itemID <- Eng_df_keepers %>%
# Remove first 2 columns
select(-c(birth_order: worried_boolean, eng_total_produced)) %>%
# Convert to long data
pivot_longer(-c(study_id:sex), names_to = "english_item", values_to = "eng_acquired") %>%
# Add item_id for each vocab
group_by(study_id, n_months) %>%
mutate(english_item_id = row_number(study_id)) %>%
# Fix typo in english_item_id (*checked with eng_cdi from wordbank)
mutate(english_item_id = case_when(english_item == "peas" ~ "131",
english_item == "peanut_butter" ~ "132",
english_item == "rocking_chair" ~ "282",
english_item == "refrigerator" ~ "283",
english_item == "window" ~ "292",
english_item == "washing_machine" ~ "293",
TRUE ~ as.character(english_item_id))) %>%
mutate(english_item_id = as.numeric(english_item_id)) %>%
ungroup() %>%
select(study_id, TRUE_months, n_months, completed, sex, eng_est_total_produced, age, english_item, english_item_id, eng_acquired) %>%
mutate(item_id = english_item_id) %>% # Will be used when merging TEs
# Rename columns for when they are joined with French
rename(eng_item_num = english_item_id,
age_eng = age,
eng_completed = completed) %>%
# Append translation equivalents (TE) list to data
left_join(TE_list, by = "eng_item_num")
# French
Fr_df_itemID <- Fr_df_keepers %>%
# Remove first 2 columns
select(-c(birth_order: worried_boolean, fr_total_produced)) %>%
# Convert to long data
pivot_longer(-c(study_id:sex), names_to = "french_item", values_to = "fr_acquired") %>%
# Add item_id for each vocab
group_by(study_id, n_months) %>%
mutate(french_item_id = row_number(study_id)) %>%
mutate(french_item_id = as.numeric(french_item_id)) %>%
# Fix spelling discrepancies for homophones
mutate(french_item = case_when(french_item == "poisson1" ~ "poisson (animal)",
french_item == "poisson2" ~ "poisson (food)",
french_item == "bain1" ~ "bain (object)",
french_item == "bain2" ~ "bain (routine)",
french_item == "poulet1" ~ "poulet (animal)",
french_item == "poulet2" ~ "poulet (food)",
french_item == "eau1" ~ "eau (beverage)",
french_item == "eau2" ~ "eau (not beverage)",
french_item == "baton1" ~ "baton (toy)",
french_item == "baton2" ~ "baton (not toy)",
french_item == "orange1" ~ "orange (food)",
french_item == "orange" ~ "orange (description)",
french_item == "pot1" ~ "pot (jar)",
french_item == "pot2" ~ "pot (potty)",
TRUE ~ as.character(french_item))) %>%
ungroup() %>%
select(study_id, TRUE_months, n_months, completed, sex, fr_est_total_produced, age, french_item, french_item_id, fr_acquired) %>%
mutate(item_id = french_item_id) %>% # Will be used when merging TEs
# Rename columns for when they are joined with English
rename(fr_item_num = french_item_id,
age_fr = age,
fr_completed = completed) %>%
# Append translation equivalents (TE) list to data
left_join(TE_list, by = "fr_item_num")
EngFr_df <- full_join(Eng_df_itemID, Fr_df_itemID, by = c("study_id", "n_months", "te_id", "eng_item_num", "fr_item_num"), suffix = c("_eng", "_fr")) %>%
# Replace with 0 the NAs in total produced in eng and fre because those children are in fact monolinguals.
mutate(eng_est_total_produced = case_when(is.na(eng_est_total_produced) ~ 0,
TRUE ~ eng_est_total_produced),
fr_est_total_produced = case_when(is.na(fr_est_total_produced) ~ 0,
TRUE ~ fr_est_total_produced)) %>%
# Replace with NA the 0s in est_total_produced when a bilingual baby did not complete the CDI in one language, but did in the other
mutate(eng_est_total_produced = case_when(eng_completed == FALSE ~ as.numeric(NA),
TRUE ~ eng_est_total_produced),
fr_est_total_produced = case_when(fr_completed == FALSE ~ as.numeric(NA),
TRUE ~ fr_est_total_produced),
age_eng = case_when(age_eng == 999 ~ as.numeric(NA),
TRUE ~ age_eng),
age_fr = case_when(age_fr == 999 ~ as.numeric(NA),
TRUE ~ age_fr),
num_datapts = case_when(is.na(TRUE_months_eng) ~ TRUE_months_fr,
is.na(TRUE_months_fr) ~ TRUE_months_eng,
TRUE_months_eng > TRUE_months_fr ~ TRUE_months_eng,
TRUE_months_fr > TRUE_months_eng ~ TRUE_months_fr,
TRUE ~ TRUE_months_eng)) %>%
# Flag any cases where sex does not match across languages
mutate(sex_match = case_when(sex_eng == sex_fr ~ "yes",
is.na(sex_fr) ~ "yes",
is.na(sex_eng) ~"yes",
TRUE ~ "no"))
# Determine sex of children with mismatch across languages
mismatch_sex_df <- EngFr_df %>%
group_by(study_id, n_months) %>%
filter(row_number() == 1,
sex_match == "no")
# Fix age (Due to the nature of the administration process where the questionnaires are sent on the 1st of each month, there would be overlaps in the age when the questionnaires are filled. So when generating the report, we rely on the n_month variable to generate an estimate age to avoid overlaps.)
EngFr_df_agefixed <- EngFr_df %>%
# Sometimes parents may have missed a language (i.e., no data), so replace NA in a missing language with the age in the other language
mutate(age_fixed = case_when(is.na(age_eng) ~ age_fr,
is.na(age_fr) ~ age_eng,
# When both languages are available, compare the age across two languages and keep the smaller number (i.e., the age they first joined the project)
age_eng < age_fr ~ age_eng,
age_eng > age_fr ~ age_fr,
# Otherwise, return the age in the English form (since this should be the same as the age in the French form)
TRUE ~ age_eng)) %>%
# There was one child with mismatched sex in English and French; the right information was manually checked. Create a single column for sex
mutate(sex = case_when(is.na(sex_eng) ~ sex_fr,
is.na(sex_fr) ~ sex_eng,
sex_eng == sex_fr ~ sex_eng,
study_id == "S0037" ~ sex_fr,
TRUE ~ sex_eng)) %>%
group_by(study_id) %>%
mutate(starting_age = min(age_fixed, na.rm = TRUE)) %>% # Extract the minimum age as the starting age of the project
ungroup() %>%
mutate(age = age_fixed)
# Word vocabulary score
word_concept_scores <- EngFr_df_agefixed %>%
mutate(words_produced = rowSums(across(c(eng_est_total_produced, fr_est_total_produced)), na.rm = FALSE),
concept_acquired = case_when(eng_acquired == 1 | fr_acquired == 1 ~ 1, TRUE ~ 0), # Determine if a concept was acquired
te_acquired = case_when(eng_acquired == 1 & fr_acquired == 1 ~ 1, TRUE ~ 0)) %>% # Determine if a TE was acquired
# Estimate number of TEs produced
group_by(study_id, n_months) %>%
mutate(te_produced = sum(te_acquired)) %>%
# Concept vocabulary score
mutate(concepts_produced = words_produced - te_produced) %>%
# Reorder columns
relocate(words_produced, .after = n_months) %>%
relocate(concepts_produced, .after = words_produced) %>%
relocate(te_produced, .after = concepts_produced) %>%
relocate(eng_est_total_produced, .after = concepts_produced) %>%
relocate(fr_est_total_produced, .after = eng_est_total_produced) %>%
relocate(concept_acquired, .after = fr_est_total_produced) %>%
relocate(fr_completed, .after = eng_completed) %>%
relocate(sex, .after = n_months) %>%
# Remove unnecessary columns
select(study_id, n_months:fr_completed, english_item:te_id, french_item:num_datapts, age, starting_age) %>%
ungroup()
CDI_LEQ_df <- word_concept_scores %>%
# Round age to match with LEQ data
mutate(age_round = round(age, digits = 0)) %>%
left_join(LEQ_01_all_phases_df, by = c("study_id", "age_round"="end_age")) %>%
# Identify and remove rows of CDI data without corresponding cumulative exposure
mutate(missing_exposure = case_when(eng_completed = TRUE & is.na(cumulative_exp_Eng) ~ "missing_Eng_exposure",
fr_completed = TRUE & is.na(cumulative_exp_Fre) ~ "missing_Fre_exposure")) %>%
filter(is.na(missing_exposure)) %>%
# Create column that groups language exposure
mutate(Eng_exposure_round = case_when(cumulative_exp_Eng >= 0 & cumulative_exp_Eng <= .33 ~ "0-33% exposure",
cumulative_exp_Eng > .33 & cumulative_exp_Eng <= .66 ~ "34-66% exposure",
cumulative_exp_Eng > .66 & cumulative_exp_Eng <= 1 ~ "67-100% exposure"),
Fre_exposure_round = case_when(cumulative_exp_Fre >= 0 & cumulative_exp_Fre <= .33 ~ "0-33% exposure",
cumulative_exp_Fre > .33 & cumulative_exp_Fre <= .66 ~ "34-66% exposure",
cumulative_exp_Fre > .66 & cumulative_exp_Fre <= 1 ~ "67-100% exposure")
) %>%
# Remove rows where neither English nor French CDI were completed
mutate(both_not_completed = case_when(eng_completed == FALSE & fr_completed == FALSE ~ "both_missing",
is.na(eng_completed) & fr_completed == FALSE ~ "both_missing",
is.na(fr_completed) & eng_completed == FALSE ~ "both_missing"
)) %>%
filter(is.na(both_not_completed))
# Merge CDI+LEQ and Eng word frequency data
biling_eng_word_frequency <- CDI_LEQ_df %>%
# # Remove rows where English CDI was not completed
# filter(eng_completed == TRUE) %>%
full_join(eng_tokens_per_month, by = "eng_item_num") %>%
relocate(item, .after = english_item) %>%
# Estimate tokens per month based on each child language exposure
mutate(eng_biling_tok_per_month = cumulative_exp_Eng * tok_per_mo,
fre_biling_tok_per_month = cumulative_exp_Fre * tok_per_mo) %>%
# Remove English homophones
filter(! item %in% eng_cdi_homophones_df$item) %>%
# Set non-dominant exposure for exposure balance
mutate(exposure_balance = case_when(cumulative_exp_Eng < cumulative_exp_Fre ~ cumulative_exp_Eng,
cumulative_exp_Fre < cumulative_exp_Eng ~ cumulative_exp_Fre,
TRUE ~ 0.5
),
# Create column that groups exposure balance
exposure_balance_round = case_when(exposure_balance >= 0 & exposure_balance <= .17 ~ "0-17% balance",
exposure_balance > .17 & exposure_balance <= .33 ~ "17-33% balance",
exposure_balance > .33 & exposure_balance <= .5 ~ "33-50% balance")
) %>%
# Assign to bins of 100 tokens
mutate(monoling_frequency_bins = case_when(tok_per_mo <= 100 ~ "0-100",
tok_per_mo > 100 & tok_per_mo <= 200 ~ "101-200",
tok_per_mo > 200 & tok_per_mo <= 300 ~ "201-300",
# tok_per_mo > 300 & tok_per_mo <= 400 ~ "301-400",
# tok_per_mo > 400 & tok_per_mo <= 500 ~ "401-500",
# tok_per_mo > 500 ~ "501-600"
tok_per_mo > 300 ~ "301+" # There is only one item (book) with frequency greater than 400, therefore it is grouped with the 401-500 bin
),
eng_biling_frequency_bins= case_when(eng_biling_tok_per_month <= 100 ~ "0-100",
eng_biling_tok_per_month > 100 & eng_biling_tok_per_month <= 200 ~ "101-200",
eng_biling_tok_per_month > 200 & eng_biling_tok_per_month <= 300 ~ "201-300",
eng_biling_tok_per_month > 300 & eng_biling_tok_per_month <= 400 ~ "301-400",
eng_biling_tok_per_month > 400 & eng_biling_tok_per_month <= 500 ~ "401-500",
eng_biling_tok_per_month > 500 ~ "501-600"),
fre_biling_frequency_bins= case_when(fre_biling_tok_per_month <= 100 ~ "0-100",
fre_biling_tok_per_month > 100 & fre_biling_tok_per_month <= 200 ~ "101-200",
fre_biling_tok_per_month > 200 & fre_biling_tok_per_month <= 300 ~ "201-300",
fre_biling_tok_per_month > 300 & fre_biling_tok_per_month <= 400 ~ "301-400",
fre_biling_tok_per_month > 400 & fre_biling_tok_per_month <= 500 ~ "401-500",
fre_biling_tok_per_month > 500 ~ "501-600")) %>%
# Remove unnecessary columns
select(-c(eng_completed, fr_completed, eng_item_num, fr_item_num, cumulative_exp_L3:missing_exposure, both_not_completed))
# Keep only nouns
biling_eng_noun_frequency <- biling_eng_word_frequency %>%
filter(lexical_class == "nouns")
# Keep only word frequency for each item, not each child
unique_nouns_only_word_frequency <- biling_eng_noun_frequency %>%
group_by(item) %>%
filter(row_number() == 1) %>% # Keep one row per item
ungroup() %>%
select(item, lexical_class, tok_per_mo)
hist(unique_nouns_only_word_frequency$tok_per_mo)
# Estimate mean and median noun frequency to center tokens per month
mean_noun_frequency <- round(mean(unique_nouns_only_word_frequency$tok_per_mo), digits = 3) #53.668
median_noun_frequency <- round(median(unique_nouns_only_word_frequency$tok_per_mo), digits = 2)
# Keep only language exposure for each child at each month, not each item
unique_child_exposure <- biling_eng_noun_frequency %>%
group_by(study_id, n_months) %>%
filter(row_number() == 1) %>% # Keep one row per child per month
ungroup() %>%
select(study_id, n_months, age, cumulative_exp_Eng, cumulative_exp_Fre, Eng_exposure_round)
# Estimate median age, English and French exposure
median_age <- round(median(unique_child_exposure$age), digits = 2)
median_eng_exposure <- round(median(unique_child_exposure$cumulative_exp_Eng), digits = 2)
median_fre_exposure <- round(median(unique_child_exposure$cumulative_exp_Fre), digits = 2)
# Center age, tokens per month, and English exposure
biling_eng_noun_frequency <- biling_eng_noun_frequency %>%
# Center variables
mutate(age_centered = age - 24, # Age centered at 2 years, approximately the middle of the age range
tok_per_mo_centered = tok_per_mo - mean_noun_frequency, # Frequency centered at the average noun frequency (53.668)
eng_exposure_centered = cumulative_exp_Eng - 0.5, # English exposure centered to completely balanced exposure
fre_exposure_centered = cumulative_exp_Fre - 0.5, # French exposure centered to completely balanced exposure
exposure_balance_centered = exposure_balance - 0.5 # Exposure balance centered to completely balanced exposure
) %>%
# Median split
mutate(age_median_split = as.factor(case_when(age <= median_age ~ "below median age",
age > median_age ~ "above median age")),
age_median_split = factor(age_median_split, levels = c("below median age", "above median age")),
noun_frequency_median_split = case_when(tok_per_mo < median_noun_frequency ~ "below median frequency",
tok_per_mo > median_noun_frequency ~ "above median frequency"),
noun_frequency_median_split = factor(noun_frequency_median_split, levels = c("below median frequency", "above median frequency")),
eng_exposure_median_split = case_when(cumulative_exp_Eng < median_eng_exposure ~ "below median English exposure",
cumulative_exp_Eng > median_eng_exposure ~ "above median English exposure"),
eng_exposure_median_split = factor(eng_exposure_median_split, levels = c("below median English exposure", "above median English exposure")),
)
save(biling_eng_noun_frequency, file = "data/biling_eng_noun_frequency.RDS")
load("data/biling_eng_noun_frequency.RDS")
# Keep only language exposure for each child at each month, not each item
unique_administrations <- biling_eng_noun_frequency %>%
group_by(study_id, n_months) %>%
filter(row_number() == 1) %>% # Keep one row per child per month
ungroup() %>%
select(study_id, n_months, sex, age, cumulative_exp_Eng, cumulative_exp_Fre, Eng_exposure_round)
# Administrations descriptives
administrations_summary <- unique_administrations %>%
group_by(study_id) %>%
mutate(start_age = min(age)) %>%
filter(n_months == max(n_months)) %>%
ungroup() %>%
summarise(total_admin = sum(n_months),
min_admin = min(n_months),
max_admin = max(n_months),
mean_admin = round(mean(n_months), digits = 2),
sd_admin = round(sd(n_months), digits = 2),
mean_start_age = round(mean(start_age), digits = 2),
sd_start_age = round(sd(start_age), digits = 2))
# Sample descriptives
bi_sample_summ <- unique_administrations %>%
summarise(N_child = length(unique(study_id)),
mean_age = round(mean(age), digits = 2),
sd_age = round(sd(age), digits = 2))
bi_sample_sex_summ <- unique_administrations %>%
group_by(study_id) %>%
filter(row_number() == 1) %>% # Keep one row per child
ungroup() %>%
group_by(sex) %>%
summarise(N_child = n())
bi_sample_lang_group_summ <- unique_administrations %>%
group_by(study_id) %>%
filter(n_months == min(n_months)) %>%
ungroup() %>%
mutate(lang_group = case_when(cumulative_exp_Eng < 0.10 | cumulative_exp_Fre < 0.10 ~ "monolingual",
TRUE ~ "bilingual")) %>%
group_by(lang_group) %>%
summarise(N_child = n())
bi_sample_lang_exp_summ <- unique_administrations %>%
group_by(study_id) %>%
filter(n_months == min(n_months)) %>%
ungroup() %>%
mutate(exposure_balance = case_when(cumulative_exp_Eng < cumulative_exp_Fre ~ cumulative_exp_Eng,
cumulative_exp_Fre < cumulative_exp_Eng ~ cumulative_exp_Fre,
TRUE ~ 0.5
)) %>%
summarise(mean_eng_exp = round(mean(cumulative_exp_Eng), digits = 2),
sd_eng_exp = round(sd(cumulative_exp_Eng), digits = 2),
min_eng_exp = round(min(cumulative_exp_Eng), digits = 2),
max_eng_exp = round(max(cumulative_exp_Eng), digits = 2),
mean_fre_exp = round(mean(cumulative_exp_Fre), digits = 2),
sd_fre_exp = round(sd(cumulative_exp_Fre), digits = 2),
min_fre_exp = round(min(cumulative_exp_Fre), digits = 2),
max_fre_exp = round(max(cumulative_exp_Fre), digits = 2),
mean_exp_bal = round(mean(exposure_balance), digits = 2),
sd_exp_bal = round(sd(exposure_balance), digits = 2),
min_exp_bal = round(min(exposure_balance), digits = 2),
max_exp_bal = round(max(exposure_balance), digits = 2))
# ENGLISH
Eng_df_demographics <- Eng_df_keepers %>%
# Remove unnecessary columns
select(-c(TRUE_months, eng_est_total_produced, age, birth_weight_lb:mother_yob, secondary_caregiver:father_education, child_hispanic_latino, caregiver_info:worried_boolean, eng_total_produced, baa_baa:then)) %>%
# Remove rows of uncompleted CDIs
filter(completed == TRUE) %>%
# Check that each baby has always the same answer
group_by(study_id) %>%
mutate(check_sex = case_when(sex != lead(sex) ~ "check"),
# check_income = case_when(annual_income != lead(annual_income) ~ "check"), # Income can vary across time
check_ethnicity = case_when(child_ethnicity != lead(child_ethnicity) ~ "check")) %>%
ungroup() %>%
mutate(sex = case_when(study_id == "S037" & sex == "Female" ~ "Male", # Fix row with typo (parents said their child is female only once)
TRUE ~ sex)) %>%
select(-c(check_sex, check_ethnicity))
# FRENCH
Fre_df_demographics <- Fr_df_keepers %>%
# Remove unnecessary columns
select(-c(TRUE_months, fr_est_total_produced, age, birth_weight_lb:mother_yob, secondary_caregiver:father_education, child_hispanic_latino, caregiver_info:worried_boolean, fr_total_produced, aie:si)) %>%
# Remove rows of uncompleted CDIs
filter(completed == TRUE) %>%
# Check that each baby has always the same answer
group_by(study_id) %>%
mutate(check_sex = case_when(sex != lead(sex) ~ "check"),
# check_income = case_when(annual_income != lead(annual_income) ~ "check"), # Income can vary across time
check_ethnicity = case_when(child_ethnicity != lead(child_ethnicity) ~ "check")) %>%
ungroup() %>%
select(-c(check_sex, check_ethnicity))
# Merge datasets
demographics_df <- full_join(Eng_df_demographics, Fre_df_demographics) %>%
# Convert income ranges into the range average. "Prefer not to disclose" will be considered NA.
mutate(income_range_average = case_when(annual_income == "25000-50000" ~ (25000+50000)/2,
annual_income == "50000-75000" ~ (50000+75000)/2,
annual_income == "75000-100000" ~ (75000+100000)/2,
annual_income == "100000-125000" ~ (100000+125000)/2,
annual_income == "125000-150000" ~ (125000+150000)/2,
annual_income == "150000-175000" ~ (150000+175000)/2,
annual_income == "175000-200000" ~ (175000+200000)/2,
annual_income == ">200000" ~ (200000+225000)/2),
birth_order = as.factor(birth_order),
birth_order_categorical = case_when(birth_order == "1" ~ "first_born",
birth_order == "0" ~ NA,
TRUE ~ "later_born"))
# Merge with item-level data
load("data/biling_eng_noun_frequency.RDS")
load("data/biling_noun_frequency_long.RDS")
biling_item_demographic <- full_join(demographics_df, biling_eng_noun_frequency)
biling_item_long_demographic <- full_join(demographics_df, biling_eng_noun_frequency_long)
biling_item_long_demographic <- full_join(demographics_df, biling_noun_frequency_long)
# load("models/bi_eng_age_times_tokmo_times_exposure.RDS")
# English
bi_eng_demo <-
glmer(eng_acquired ~ -1 + sex + birth_order + mother_education + child_ethnicity + income_range_average +
age_centered * tok_per_mo_centered * eng_exposure_centered + (1 | english_item) + (1 | study_id),
data = biling_item_demographic,
family = binomial,
nAGQ = 0)
beep()
r2(bi_eng_demo)
# French
bi_fre_demo <-
glmer(eng_acquired ~ -1 + sex + birth_order + mother_education + child_ethnicity + income_range_average +
age_centered * tok_per_mo_centered * fre_exposure_centered + (1 | french_item) + (1 | study_id),
data = biling_item_demographic,
family = binomial,
nAGQ = 0)
beep()
r2(bi_fre_demo)
# Word
bi_word_demo <-
glmer(word_acquired ~ -1 + sex + birth_order + mother_education + child_ethnicity + income_range_average +
age_centered * tok_per_mo_centered * lang_exposure_centered + (1 | word) + (1 | study_id),
data = biling_item_long_demographic,
family = binomial,
nAGQ = 0)
beep()
r2(bi_word_demo)
# Concept
bi_concept_demo <-
glmer(concept_acquired ~ -1 + sex + birth_order + mother_education + child_ethnicity + income_range_average +
age_centered * tok_per_mo_centered * exposure_balance_centered + (1 | item) + (1 | study_id),
data = biling_item_demographic,
family = binomial,
nAGQ = 0)
beep()
r2(bi_concept_demo)
