knitr::opts_chunk$set(echo = TRUE)
# Read needed packages
library(tidyverse)
library(beepr)
library(lme4)
library(performance)
library(report)
library(jtools)
library(sjPlot)
library(effects)
library(ggeffects)
library(ggh4x)
library(gtsummary)
library(ggpubr)
library(ggsci)
load("data/biling_eng_noun_frequency.RDS")
# Keep only language exposure for each child at each month, not each item
unique_administrations <- biling_eng_noun_frequency %>%
group_by(study_id, n_months) %>%
filter(row_number() == 1) %>% # Keep one row per child per month
ungroup() %>%
select(study_id, n_months, sex, age, cumulative_exp_Eng, cumulative_exp_Fre, Eng_exposure_round)
# Administrations descriptives
administrations_summary <- unique_administrations %>%
group_by(study_id) %>%
mutate(start_age = min(age)) %>%
filter(n_months == max(n_months)) %>%
ungroup() %>%
summarise(total_admin = sum(n_months),
min_admin = min(n_months),
max_admin = max(n_months),
mean_admin = round(mean(n_months), digits = 2),
sd_admin = round(sd(n_months), digits = 2),
mean_start_age = round(mean(start_age), digits = 2),
sd_start_age = round(sd(start_age), digits = 2))
# Sample descriptives
bi_sample_summ <- unique_administrations %>%
summarise(N_child = length(unique(study_id)),
mean_age = round(mean(age), digits = 2),
sd_age = round(sd(age), digits = 2))
bi_sample_sex_summ <- unique_administrations %>%
group_by(study_id) %>%
filter(row_number() == 1) %>% # Keep one row per child
ungroup() %>%
group_by(sex) %>%
summarise(N_child = n())
bi_sample_lang_group_summ <- unique_administrations %>%
group_by(study_id) %>%
filter(n_months == min(n_months)) %>%
ungroup() %>%
mutate(lang_group = case_when(cumulative_exp_Eng < 0.10 | cumulative_exp_Fre < 0.10 ~ "monolingual",
TRUE ~ "bilingual")) %>%
group_by(lang_group) %>%
summarise(N_child = n())
bi_sample_lang_exp_summ <- unique_administrations %>%
group_by(study_id) %>%
filter(n_months == min(n_months)) %>%
ungroup() %>%
mutate(exposure_balance = case_when(cumulative_exp_Eng < cumulative_exp_Fre ~ cumulative_exp_Eng,
cumulative_exp_Fre < cumulative_exp_Eng ~ cumulative_exp_Fre,
TRUE ~ 0.5
)) %>%
summarise(mean_eng_exp = round(mean(cumulative_exp_Eng), digits = 2),
sd_eng_exp = round(sd(cumulative_exp_Eng), digits = 2),
min_eng_exp = round(min(cumulative_exp_Eng), digits = 2),
max_eng_exp = round(max(cumulative_exp_Eng), digits = 2),
mean_fre_exp = round(mean(cumulative_exp_Fre), digits = 2),
sd_fre_exp = round(sd(cumulative_exp_Fre), digits = 2),
min_fre_exp = round(min(cumulative_exp_Fre), digits = 2),
max_fre_exp = round(max(cumulative_exp_Fre), digits = 2),
mean_exp_bal = round(mean(exposure_balance), digits = 2),
sd_exp_bal = round(sd(exposure_balance), digits = 2),
min_exp_bal = round(min(exposure_balance), digits = 2),
max_exp_bal = round(max(exposure_balance), digits = 2))
View(bi_sample_summ)
View(bi_sample_lang_group_summ)
76+27
load("figures/mono_eng_interactive_viz.png")
knitr::opts_chunk$set(echo = TRUE)
# # Install packages
# install.packages(c("tidyverse", "lme4", "wordbankr", "ggpubr", "purrr", "psych", "beepr", "devtools"))
# # Install Wordbankr
# devtools::install_github("langcog/wordbankr")
# Load libraries
library(tidyverse)
# library(childes-db)
# library(childesr)
library(wordbankr)
library(lme4)
library(ggpubr)
# library(purrr)
# library(psych)
library(beepr)
library(jtools)
library(report)
library(gtsummary)
library(performance)
# Create monolingual English graph to be combined with the French viz
load("data/mono_eng_nouns_only_word_frequency.RDS")
mono_eng_nouns_only_word_frequency <- mono_eng_nouns_only_word_frequency %>%
mutate(frequency_bins = case_when(tok_per_mo <= 100 ~ "0-100",
tok_per_mo > 100 & tok_per_mo <= 200 ~ "101-200",
tok_per_mo > 200 & tok_per_mo <= 300 ~ "201-300",
tok_per_mo > 300 ~ "301+"), # There is only one item (book) with frequency greater than 400, therefore it is grouped with the 300+ bin
)
# Visualize age*frequency interaction
mono_eng_interactive_viz <- ggplot(data = mono_eng_nouns_only_word_frequency, aes(x = age, y = produces, color = frequency_bins)) +
# geom_point() +
geom_smooth(method = "glm",
method.args = list(family = "binomial"),
# se = FALSE,
alpha = 0.3
) +
scale_color_bmj() +
ylim(NA,1) +
labs(title = "English Monolingual Word Learning",
x = "Age (months)",
y = "Probability of word production",
color = "Monthly concept \nfrequency")
?scale_color_bmj
knitr::opts_chunk$set(echo = TRUE)
library(ggsci)
# Visualize age*frequency interaction
mono_eng_interactive_viz <- ggplot(data = mono_eng_nouns_only_word_frequency, aes(x = age, y = produces, color = frequency_bins)) +
# geom_point() +
geom_smooth(method = "glm",
method.args = list(family = "binomial"),
# se = FALSE,
alpha = 0.3
) +
scale_color_bmj() +
ylim(NA,1) +
labs(title = "English Monolingual Word Learning",
x = "Age (months)",
y = "Probability of word production",
color = "Monthly concept \nfrequency")
mono_eng_interactive_viz
load("data/mono_fre_nouns_only_cdi_data.RDS")
# hist(nouns_only_word_frequency$tok_per_mo)
# Visualize age*frequency interaction
mono_fre_interactive_viz <- ggplot(data = mono_fre_nouns_only_cdi_data, aes(x = age, y = produces, color = frequency_bins)) +
# geom_point() +
geom_smooth(method = "glm",
method.args = list(family = "binomial"),
# se = FALSE,
alpha = 0.3
) +
scale_color_bmj() +
ylim(NA,1) +
labs(title = "French Monolingual Word Learning",
x = "Age (months)",
y = "Probability of word production",
color = "Monthly concept \nfrequency")
mono_fre_interactive_viz
# Arrange two plots into a single image
mono_interactive_plots <- ggarrange(mono_eng_interactive_viz, mono_fre_interactive_viz,
nrow = 2
)
mono_interactive_plots
ggsave("figures/mono_interactive_plots.png", plot = mono_interactive_plots,
width = 16,
height = 15,
units = "cm")
knitr::opts_chunk$set(echo = TRUE)
# Load libraries
library(tidyverse)
library(stringi)
library(beepr)
library(ggpubr)
# library(patchwork)
library(gridExtra)
my_colors <- c("#0F62CD","#6094FF", "#A391F8","#FBBCBC", "#F96D99", "#D11991", "#DB1D00","#E56B00","#EDB100","#1D8E6C")
load("data/vocabsize_by_time_df2.RDS")
# Convert exposure balance to percentage and factor
vocabsize_by_time_df2 <- vocabsize_by_time_df2 %>%
mutate(lang_exposure_2 = as.factor(lang_exposure_2 * 100))
# Smooth plot of vocabulary size across time
sim2_viz <- ggplot(data = vocabsize_by_time_df2, aes(x = time_point, y = word_vocabulary_size, color = lang_exposure_2)) +
# geom_smooth() +
geom_line() +
labs(title = "Simulation 2: Total Word Vocabulary Without Transfer",
x = "Time steps",
y = "Total word vocabulary size (words)",
color = "Exposure balance (%)") +
geom_vline(xintercept = 6000, linetype="dashed") +
geom_vline(xintercept = 12000, linetype="dashed") +
scale_color_manual(values=my_colors)
# theme(#text=element_text(size=15),
#       legend.position = "none")
sim2_viz
load("data/vocabsize_by_time_df3.RDS")
# Convert exposure balance to percentage and factor
vocabsize_by_time_df3 <- vocabsize_by_time_df3 %>%
mutate(exposure_balance = as.factor(exposure_balance * 100))
# Smooth plot of vocabulary size across time
sim3_viz <- ggplot(data = vocabsize_by_time_df3, aes(x = time_point, y = concept_vocabulary_size, color = exposure_balance)) +
# geom_smooth() +
geom_line() +
labs(title = "Simulation 3: Concept Vocabulary Without Transfer",
x = "Time steps",
y = "Concept vocabulary size (words)",
color = "Exposure balance (%)") +
geom_vline(xintercept = 6000, linetype="dashed") +
scale_color_manual(values=my_colors)
sim3_viz
load("data/vocabsize_by_time_df4.RDS")
# Convert exposure balance to percentage and factor
vocabsize_by_time_df4 <- vocabsize_by_time_df4 %>%
mutate(lang_exposure_2 = as.factor(lang_exposure_2 * 100))
# Smooth plot of vocabulary size across time
sim4_viz <- ggplot(data = vocabsize_by_time_df4, aes(x = time_point, y = word_vocabulary_size, color = as.factor(lang_exposure_2))) +
# geom_smooth() +
geom_line() +
labs(title = "Simulation 4: Total Word Vocabulary With Transfer",
x = "Time steps",
y = "Total word vocabulary size (words)",
color = "Exposure balance (%)") +
geom_vline(xintercept = 6000, linetype="dashed") +
geom_vline(xintercept = 12000, linetype="dashed") +
scale_color_manual(values=my_colors)
sim4_viz
load("data/vocabsize_by_time_df5.RDS")
# Convert exposure balance to percentage and factor
vocabsize_by_time_df5 <- vocabsize_by_time_df5 %>%
mutate(exposure_balance = as.factor(exposure_balance * 100))
# Smooth plot of vocabulary size across time
sim5_viz <- ggplot(data = vocabsize_by_time_df5, aes(x = time_point, y = concept_vocabulary_size, color = exposure_balance)) +
# geom_smooth() +
geom_line() +
labs(title = "Simulation 5: Concept Vocabulary With Transfer",
x = "Time steps",
y = "Concept vocabulary size (words)",
color = "Exposure balance (%)") +
geom_vline(xintercept = 6000, linetype="dashed") +
scale_color_manual(values=my_colors)
sim5_viz
simulations_2_to_3 <- ggarrange(sim2_viz, sim3_viz,
#labels = c("Simulation 1", "Simulation 2", "Simulation 3", "Simulation 4", "Simulation 5"),
ncol = 1, nrow = 2,
common.legend = TRUE, legend = "bottom")
simulations_2_to_3
simulations_4_to_5 <- ggarrange(sim4_viz, sim5_viz,
#labels = c("Simulation 1", "Simulation 2", "Simulation 3", "Simulation 4", "Simulation 5"),
ncol = 1, nrow = 2,
common.legend = TRUE, legend = "bottom")
simulations_4_to_5
ggsave("figures/simulations_2_to_3.png", plot = simulations_2_to_3,
width = 20,
height = 22,
units = "cm"
)
ggsave("figures/simulations_4_to_5.png", plot = simulations_4_to_5,
width = 20,
height = 22,
units = "cm"
)
