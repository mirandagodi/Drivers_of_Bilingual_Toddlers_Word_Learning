knitr::opts_chunk$set(echo = TRUE)
# Read needed packages
library(tidyverse)
library(beepr)
library(lme4)
library(performance)
library(report)
library(jtools)
library(sjPlot)
library(effects)
library(ggeffects)
library(ggh4x)
library(gtsummary)
library(ggpubr)
library(ggsci)
load("data/biling_eng_noun_frequency.RDS")
# Keep only language exposure for each child at each month, not each item
unique_administrations <- biling_eng_noun_frequency %>%
group_by(study_id, n_months) %>%
filter(row_number() == 1) %>% # Keep one row per child per month
ungroup() %>%
select(study_id, n_months, sex, age, cumulative_exp_Eng, cumulative_exp_Fre, Eng_exposure_round)
# Administrations descriptives
administrations_summary <- unique_administrations %>%
group_by(study_id) %>%
mutate(start_age = min(age)) %>%
filter(n_months == max(n_months)) %>%
ungroup() %>%
summarise(total_admin = sum(n_months),
min_admin = min(n_months),
max_admin = max(n_months),
mean_admin = round(mean(n_months), digits = 2),
sd_admin = round(sd(n_months), digits = 2),
mean_start_age = round(mean(start_age), digits = 2),
sd_start_age = round(sd(start_age), digits = 2))
# Sample descriptives
bi_sample_summ <- unique_administrations %>%
summarise(N_child = length(unique(study_id)),
mean_age = round(mean(age), digits = 2),
sd_age = round(sd(age), digits = 2))
bi_sample_sex_summ <- unique_administrations %>%
group_by(study_id) %>%
filter(row_number() == 1) %>% # Keep one row per child
ungroup() %>%
group_by(sex) %>%
summarise(N_child = n())
bi_sample_lang_group_summ <- unique_administrations %>%
group_by(study_id) %>%
filter(n_months == min(n_months)) %>%
ungroup() %>%
mutate(lang_group = case_when(cumulative_exp_Eng < 0.10 | cumulative_exp_Fre < 0.10 ~ "monolingual",
TRUE ~ "bilingual")) %>%
group_by(lang_group) %>%
summarise(N_child = n())
bi_sample_lang_exp_summ <- unique_administrations %>%
group_by(study_id) %>%
filter(n_months == min(n_months)) %>%
ungroup() %>%
mutate(exposure_balance = case_when(cumulative_exp_Eng < cumulative_exp_Fre ~ cumulative_exp_Eng,
cumulative_exp_Fre < cumulative_exp_Eng ~ cumulative_exp_Fre,
TRUE ~ 0.5
)) %>%
summarise(mean_eng_exp = round(mean(cumulative_exp_Eng), digits = 2),
sd_eng_exp = round(sd(cumulative_exp_Eng), digits = 2),
min_eng_exp = round(min(cumulative_exp_Eng), digits = 2),
max_eng_exp = round(max(cumulative_exp_Eng), digits = 2),
mean_fre_exp = round(mean(cumulative_exp_Fre), digits = 2),
sd_fre_exp = round(sd(cumulative_exp_Fre), digits = 2),
min_fre_exp = round(min(cumulative_exp_Fre), digits = 2),
max_fre_exp = round(max(cumulative_exp_Fre), digits = 2),
mean_exp_bal = round(mean(exposure_balance), digits = 2),
sd_exp_bal = round(sd(exposure_balance), digits = 2),
min_exp_bal = round(min(exposure_balance), digits = 2),
max_exp_bal = round(max(exposure_balance), digits = 2))
View(bi_sample_summ)
View(bi_sample_lang_group_summ)
76+27
