load("data/eng_tokens_per_month.RDS")
load("data/fre_tokens_per_month.RDS")
eng_fre_tokens_per_month <- full_join(eng_tokens_per_month, fre_tokens_per_month, # Merge Eng and Fre word frequency data sets
join_by(item == uni_lemma),
suffix = c("_eng", "_fre")) %>%
filter((lexical_class_eng == "nouns" | lexical_class_fre == "nouns"),
!is.na(tok_per_mo_fre),
!is.na(tok_per_mo_eng)#,
# tok_per_mo_fre < 1000
)
# Correlation with homophones (174 nouns)
cor_word_freq <- cor(eng_fre_tokens_per_month$tok_per_mo_eng, eng_fre_tokens_per_month$tok_per_mo_fre)
ggscatter(eng_fre_tokens_per_month, x = "tok_per_mo_eng", y = "tok_per_mo_fre",
add = "reg.line", conf.int = TRUE,
cor.coef = TRUE, cor.method = "pearson",
xlab = "English word frequency", ylab = "French word frequency")
# Remove homophones
load("data/fre_cdi_homophones_df.RDS")
load("data/eng_cdi_homophones_df.RDS")
eng_fre_tokens_per_month_nonhomophones <- eng_fre_tokens_per_month %>%
filter(! (fre_item %in% fre_cdi_homophones_df$fre_item),
! (item %in% eng_cdi_homophones_df$item))
# Correlation without homophones (160 nouns)
cor_word_freq_nonhomophones <- cor(eng_fre_tokens_per_month_nonhomophones$tok_per_mo_eng, eng_fre_tokens_per_month_nonhomophones$tok_per_mo_fre)
ggscatter(eng_fre_tokens_per_month_nonhomophones, x = "tok_per_mo_eng", y = "tok_per_mo_fre",
add = "reg.line", conf.int = TRUE,
cor.coef = TRUE, cor.method = "pearson",
xlab = "English word frequency", ylab = "French word frequency")
